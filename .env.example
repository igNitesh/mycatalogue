# ==============================================================================
# mycatalogue - Environment Configuration (.env.example)
# Copy this file to .env and adjust the values according to your environment.
# Never commit .env with actual production secrets.
# ==============================================================================

# Django Core
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-change-me-in-production-random-value-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,testserver

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://mycatalogue_user:mycatalogue_password@db:5432/mycatalogue_db

# PostgreSQL Container Variables (used by Docker Compose)
POSTGRES_DB=mycatalogue_db
POSTGRES_USER=mycatalogue_user
POSTGRES_PASSWORD=mycatalogue_password
POSTGRES_PORT=5432

# Application Port
WEB_PORT=8000

# Security (Staging & Production only - set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
